{
  "permissions": {
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/guard_live.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/lint_python.py"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "trivia-content": {
      "command": "python",
      "args": ["mcp_server/trivia_content_server.py"]
    }
  }
}
