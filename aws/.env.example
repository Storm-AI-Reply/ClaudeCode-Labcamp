# Copy to aws/.env and fill in. aws/.env is git-ignored.
#
# AWS CLI profile used for every command in this folder. Must be configured
# with `aws configure sso` (or compatible) and have admin-like permissions
# in the target account (needed to create IAM roles/policies and call
# sts:AssumeRole).
AWS_PROFILE=social

# Region where participants will use Bedrock (and where STS calls go).
AWS_REGION=eu-west-1

# Optional. Set after ./setup-role.sh runs so generate-sessions.sh can reuse it
# without extra flags. The setup script prints the exact value.
# LABCAMP_ROLE_ARN=arn:aws:iam::123456789012:role/LabcampBedrockRole
